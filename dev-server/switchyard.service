[Unit]
Description=Switchyard Server

[Service]
# Create a temporary user to run as, extra security
DynamicUser=yes

# systemd loads these for us and makes them accessible
LoadCredential=config.toml:/etc/switchyard/config.toml
LoadCredential=tls-key.pem:/etc/switchyard/key.pem
LoadCredential=tls-cert.pem:/etc/switchyard/cert.pem

# %d is where systemd put those files
ExecStart=/usr/local/bin/switchyard-server \
    -p 443 \
    --config %d/config.toml \
    --tls-key %d/tls-key.pem \
    --tls-cert %d/tls-cert.pem \
    --trajectory-log-file /var/log/switchyard/rsi-execution.jsonl \
    --rsi-routing-log-file /var/log/switchyard/rsi-routing.jsonl \
    --rsi-recognizer-log-file /var/log/switchyard/rsi-recognizer.jsonl

# Creates /var/log/switchyard and gives the dynamic service user access.
LogsDirectory=switchyard

Restart=on-failure
Environment="NVIDIA_API_KEY=<PUT-THE-KEY-HERE>"
# The switchyard/rsi route reads its dictionary from MySQL. Change this URL if
# MySQL runs elsewhere. A lookup failure falls back to the flagship model.
Environment="RSI_MYSQL_URL=mysql://127.0.0.1:3306/switchyard"

PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Allow port 443
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target


